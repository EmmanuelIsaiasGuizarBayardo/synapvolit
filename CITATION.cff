cff-version: 1.2.0
message: "Si usas este proyecto en un trabajo académico, cítalo así."
title: "SynapVolit"
abstract: "Motor de adquisición, procesamiento y decodificación de sEMG para aplicaciones de DUNNE."
type: software
license: MIT
repository-code: "https://github.com/EmmanuelIsaiasGuizarBayardo/synapvolit"
version: "0.1.0"

# Autores: quienes aparecen al citar. Cada uno tiene su sección en CREDITS.md
# con el mismo nombre; tests/test_gobernanza.py verifica la correspondencia.
authors:
  - given-names: "Emmanuel Isaías"
    family-names: "Guízar Bayardo"
    affiliation: "División Universitaria de Neuroingeniería (DUNNE), Departamento de Ingeniería en Sistemas Biomédicos (DISB), División de Ingeniería Mecánica e Industrial (DIMEI), Facultad de Ingeniería (FI), Universidad Nacional Autónoma de México (UNAM)"

# Datos y software de terceros: su referencia formal vive solo aquí.
# references:
#   - type: data
#     title: "Título del dataset"
#     doi: "10.xxxx/..."   # con versión, si el repositorio versiona sus DOI
#     license: CC0-1.0
#     authors:
#       - family-names: "Apellido"
#         given-names: "Nombre"

references:
